{
  "name": "sofi-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Sofi AI assistant for Viber",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "fastify": "^5.6.1",
    "pino": "^9.9.4",
    "zod": "^4.1.5",
    "pg": "^8.16.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4",
    "@types/pg": "^8.15.5"
  }
}
